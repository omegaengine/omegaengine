<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <AssemblyName>Template.AlphaFramework.World</AssemblyName>
    <RootNamespace>Template.AlphaFramework.World</RootNamespace>
    <OutputPath>..\artifacts\$(Configuration)\</OutputPath>
    <TargetFrameworks>net472;net10.0</TargetFrameworks>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)'=='net10.0'">
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="AlphaFramework.World" Version="$(OmegaEngineVersion)" />
    <PackageReference Include="NanoByte.CloneGenerator" Version="0.1.1" PrivateAssets="All" />
  </ItemGroup>

</Project>
