<?xml version="1.0" encoding="utf-8"?>
<Dialog xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema" Fullscreen="true">
  <ColorBackground A="0" R="0" G="0" B="0" />
  <ColorCaption A="128" R="96" G="128" B="255" />
  <ColorText A="255" R="255" G="255" B="255" />
  <OnShow>ResumeGame.Enabled = Game.CanResume</OnShow>
  <FontSize>30</FontSize>
  <Size Width="1024" Height="768" />
  <Shift X="0" Y="0" />
  <Label Name="Logo" FontScale="1.5" Text="Frame of Reference">
    <Location X="47" Y="-200" />
    <Size Width="188" Height="100" />
    <AlignVertical>Center</AlignVertical>
    <TextAlign>Center</TextAlign>
  </Label>
  <Button Name="ResumeGame" Text="[Resume]" Hotkey="Return">
    <Location X="40" Y="-120" />
    <Size Width="200" Height="50" />
    <AlignVertical>Center</AlignVertical>
    <OnClick>LoadDialog("Loading", {Splash = true})
Game:ResumeGame()</OnClick>
  </Button>
  <Button Name="NewGame" Default="true" Text="[NewGame]" Hotkey="N">
    <Location X="40" Y="-60" />
    <Size Width="200" Height="50" />
    <AlignVertical>Center</AlignVertical>
    <OnClick>LoadDialog("Loading", {Splash = true})
Game:LoadMap("Tutorial")</OnClick>
  </Button>
  <Button Name="LoadGame" Text="[LoadGame]" Hotkey="L">
    <Location X="40" Y="0" />
    <Size Width="200" Height="50" />
    <AlignVertical>Center</AlignVertical>
    <OnClick>Me:Close()
LoadDialog("SavegameLoad", {Modal = true})</OnClick>
  </Button>
  <Button Name="Settings" Text="[Settings]" Hotkey="C">
    <Location X="40" Y="60" />
    <Size Width="200" Height="50" />
    <AlignVertical>Center</AlignVertical>
    <OnClick>Me:Close()
LoadDialog("Settings", {Modal = true})</OnClick>
  </Button>
  <Button Name="Exit" Text="[Exit]">
    <Location X="40" Y="120" />
    <Size Width="200" Height="50" />
    <AlignVertical>Center</AlignVertical>
    <OnClick>Game:Exit()</OnClick>
  </Button>
  <Label Name="Version" Text="[Version]">
    <Location X="30" Y="30" />
    <Size Width="200" Height="30" />
    <AlignHorizontal>FromRight</AlignHorizontal>
    <AlignVertical>FromBottom</AlignVertical>
    <TextAlign>Right</TextAlign>
  </Label>
</Dialog>
