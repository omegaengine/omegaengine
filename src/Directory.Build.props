<Project>

  <!-- Build configuration -->
  <PropertyGroup>
    <LangVersion>13.0</LangVersion>
    <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
    <OutputType>Library</OutputType>
    <!--suppress MsbuildTargetFrameworkTagInspection -->
    <TargetFrameworks>net10.0-windows</TargetFrameworks>
    <EnableWindowsTargeting>True</EnableWindowsTargeting>
    <Nullable>annotations</Nullable>
    <ProduceReferenceAssembly>True</ProduceReferenceAssembly>
    <GenerateDocumentationFile>True</GenerateDocumentationFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <NoWarn>$(NoWarn);1591;NU1900;NU1901;NU1902;NU1903;NU1904;WFO1000</NoWarn><!-- Missing XML comments + NuGet advisories + WinForms designer serialization of control properties (default behavior is intended) -->
    <Version>1.0.0-pre</Version><!-- Overriden by build scripts -->
  </PropertyGroup>
  <PropertyGroup Condition="$(TargetFramework.EndsWith('-windows'))">
    <UseWindowsForms>True</UseWindowsForms>
  </PropertyGroup>

  <!-- Publish configuration -->
  <PropertyGroup>
    <SatelliteResourceLanguages>de</SatelliteResourceLanguages>
    <PublishDocumentationFiles>False</PublishDocumentationFiles>
  </PropertyGroup>

  <!-- NuGet Metadata -->
  <PropertyGroup>
    <Authors>Bastian Eicher</Authors>
    <Copyright>Copyright Bastian Eicher</Copyright>
    <PackageLicenseExpression>MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/omegaengine/omegaengine</RepositoryUrl>
    <PackageProjectUrl>https://omegaengine.de/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon-omega.png</PackageIcon>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" Condition="Exists('$(MSBuildProjectDirectory)\README.md')" />
    <None Include="$(MSBuildThisFileDirectory)..\icon-omega.png" Pack="true" PackagePath="" />
  </ItemGroup>

  <!-- Build-time dependencies -->
  <ItemGroup>
    <PackageReference Include="NanoByte.CloneGenerator" Version="0.2.0" PrivateAssets="All" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="10.0.401" PrivateAssets="All" />
  </ItemGroup>

  <!-- Global usings -->
  <ItemGroup>
    <Using Include="NanoByte.Common" />
    <Using Include="NanoByte.Common.Collections" />
    <Using Include="NanoByte.CloneGenerator" />
  </ItemGroup>

</Project>
